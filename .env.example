# ==============================================================================
# Splunk 환경 설정
# ==============================================================================
SPLUNK_IMAGE=splunk/splunk:latest
# SPLUNK_PASSWORD는 최소 12자 이상의 강력한 비밀번호를 설정해야 기동됩니다.
SPLUNK_PASSWORD=
SPLUNK_TOKEN=
SPLUNK_WEB_PORT=8000
SPLUNK_MGMT_PORT=8089
SPLUNK_HEC_PORT=8088
SPLUNK_S2S_PORT=9997
SPLUNK_HEC_TOKEN=
SPLUNK_MGMT_URL=https://splunk:8089
SPLUNK_HEC_URL=https://splunk:8088
SPLUNK_CA_FILE=
SPLUNK_INSECURE_SKIP_VERIFY=true

SPLUNK_RO_USER=siem_agent_ro
SPLUNK_RO_PASSWORD=
SPLUNK_DEPLOY_USER=dac_deployer
SPLUNK_DEPLOY_PASSWORD=

# ==============================================================================
# 테스트 데이터 일일 자동 생성 스케줄러 (매일 아침 06:00 기본값)
# ==============================================================================
TESTDATA_SCHEDULE_ENABLED=true
TESTDATA_SCHEDULE_HOUR=6
TESTDATA_SCHEDULE_MINUTE=0
TESTDATA_TIMEZONE=Asia/Seoul

# ==============================================================================
APP_LISTEN_ADDR=:5090
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
APP_SESSION_KEY=

# ==============================================================================
# 스토리지 및 규칙 Git 저장소
# ==============================================================================
SQLITE_PATH=./data/siem_agent.db
RULES_REPO_PATH=./rules

# ==============================================================================
# DaC (Detection as Code) 전용 규칙 Git 저장소 설정
# ==============================================================================
DAC_GIT_ENABLED=true
DAC_GIT_REPO_URL=
DAC_GIT_BRANCH=main
DAC_GIT_TOKEN=
DAC_GIT_LOCAL_PATH=./data/rules_repo
DAC_GIT_AUTHOR_NAME=logccino-dac-bot
DAC_GIT_AUTHOR_EMAIL=dac-bot@logccino.local
DAC_GIT_SYNC_INTERVAL_SEC=300
DAC_GIT_AUTO_PUSH=true

# ==============================================================================
# LLM (OpenAI API) 설정 (로컬 LLM 없음)
# ==============================================================================
DEFAULT_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_JUDGE_MODEL=gpt-4o
LLM_REBUTTAL_MODEL=gpt-4o
LLM_RULEMAKER_MODEL=gpt-4o
LLM_ASSIST_MODEL=gpt-4o

LLM_REDACT_FIELDS=user,src_user,email,dest_host,src_host
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=4
LLM_MAX_TOKENS_PER_TICKET=60000
LLM_DAILY_TOKEN_LIMIT=5000000

# ==============================================================================
# 네트워크 프록시 (사내망 연동 시)
# ==============================================================================
HTTPS_PROXY=
NO_PROXY=splunk,localhost,127.0.0.1

# ==============================================================================
# 작업 파라미터 임계값
# ==============================================================================
TRIAGE_MAX_TOOL_CALLS=10
RULEMAKER_MAX_ITERATIONS=3
