# OpenSearch Settings
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=logccino-logs

# Core API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# AI / LLM Integration (OpenSearch Natural Query / Analysis)
LLM_PROVIDER=openai # openai | gemini
DEFAULT_MODEL=gpt-6-luna
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
GEMINI_API_KEY=
