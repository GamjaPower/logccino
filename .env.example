# OpenSearch Settings
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=logccino-logs

# Core API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# AI / LLM Integration (OpenSearch Natural Query / Analysis)
LLM_PROVIDER=gemini # gemini | openai
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash
