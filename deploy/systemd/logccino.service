[Unit]
Description=Logccino Agent-Native Big Data & Real-Time Intelligence Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Workspace/logccino
Environment="PATH=%h/Workspace/logccino/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=%h/Workspace/logccino"
EnvironmentFile=-%h/Workspace/logccino/.env
ExecStart=%h/Workspace/logccino/.venv/bin/python -m core.main
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logccino

[Install]
WantedBy=default.target
